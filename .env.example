# Copiá este archivo como ".env" y completá los valores.

# --- Paquete contratado: 1 = Catálogo, 2 = Tienda con stock, 3 = Tienda + clientes ---
PACKAGE=3

# --- Servidor ---
PORT=3000
NODE_ENV=development
# URL pública del sitio, sin barra final. Se usa para SEO (canonical, sitemap) y para Mercado Pago.
SITE_URL=http://localhost:3000
# Secreto para las sesiones del panel (mínimo 24 caracteres en producción).
JWT_SECRET=cambiar-por-un-texto-largo-y-aleatorio

# --- Base de datos MySQL ---
# Opción A: datos sueltos (local con MySQL Workbench)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=ellas_tambien
# Opción B: una sola URL (en Railway alcanza con MYSQL_URL). Si está, tiene prioridad.
# DATABASE_URL=mysql://usuario:clave@host:3306/ellas_tambien

# --- Primer usuario del panel (se crea solo si la tabla users está vacía) ---
ADMIN_EMAIL=dueno@ejemplo.com
ADMIN_PASSWORD=luisi123

# --- Mercado Pago (paquetes 2 y 3). Dejalo vacío para ofrecer solo transferencia y efectivo ---
MP_ACCESS_TOKEN=

# --- Pedidos ---
# Horas que se reserva el stock de un pedido sin pagar antes de cancelarse solo.
RESERVE_HOURS=48

# --- Fotos subidas desde el panel ---
# En Railway montá un Volume y poné acá su ruta (por ejemplo /data/uploads) para que no se pierdan.
# UPLOAD_DIR=./public/uploads
